# Local identity for the `smart` dictation profile.
#
# Copy this file to ~/.config/voxtype/identity.env and set your own name.
# That path is outside the repository on purpose: the identity is never
# committed, and the profile degrades gracefully when this file is absent.
#
# When the file exists and DICTATION_IDENTITY is non-empty, the wrapper
# appends a signature rule to the system prompt. When it does not, the profile
# simply never signs anything.
#
#   install -m 600 /dev/null ~/.config/voxtype/identity.env
#   printf 'DICTATION_IDENTITY="Your Name"\n' > ~/.config/voxtype/identity.env

DICTATION_IDENTITY=""
